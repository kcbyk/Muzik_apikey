# ============================================================================
# 19) API ANAHTARI DOGRULAMA  (x-api-key / ?api_key=)
# ============================================================================
# Virgulle ayrilmis liste. Ornek: ALLOWED_API_KEYS=anahtar1,anahtar2
# Bos ise koruma KAPALIDIR (yalnizca gelistirme icin).
ALLOWED_API_KEYS=

# Listeye ek olarak eski tek anahtar da kabul edilir (geriye uyumluluk).
API_KEY=

# true -> ALLOWED_API_KEYS bos olsa bile istekleri 401 ile reddet (siki mod).
API_KEY_REQUIRED=false

# ============================================================================
# 18) IMZA MOTORU + TOKEN CACHE POOL
# ============================================================================
# NOT: Bu katman yalnizca REQUEST PARAMETRESI uretir (sig/ts/expires...).
# Icerik cozme / DRM / AES anahtari kapsam DISIDIR.

# Imza motorunu tamamen kapatmak icin false
SIGNER_ENABLED=true

# Turetim spec'i. BOS = "derive" stratejisi kapali (varsayilan).
# Sozdizimi:  key=ifade;key2=ifade
# Token'lar : {id} {ts} {ts_ms} {ts_plus:300} {nonce} {secret} {cookie:AD} {query:AD} {header:AD} {env:DEGISKEN}
# Fonksiyon : sha256_hex / sha256_b64url / md5_hex / hmac_sha256_hex(data,key) / upper / b64url ...
#   Ornek:  SIGNER_SPEC='sig=hmac_sha256_hex({id}|{ts},{secret});ts={ts};expires={ts_plus:300}'
SIGNER_SPEC=

# {secret} token'inin degeri (SIGNER_SPEC icinde kullanilir). Loglanmaz.
SIGNER_SECRET=

# Token cache pool (TTL'li imza parametresi havuzu)
SIGNER_POOL_ENABLED=true
SIGNER_POOL_TTL_MS=120000
SIGNER_POOL_MAX=500
# Arka plan tazeleme periyodu (ms). 0 = kapali.
SIGNER_REFRESH_MS=30000

# ============================================================================
#  SUNO BEAT PROXY - ORTAM DEGISKENLERI ORNEGI
#  Bu dosyayi ".env" olarak kopyalayin:  cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 0) SAGLAYICI SECIMI (en onemli ayar)
# ----------------------------------------------------------------------------
# suno | replicate | elevenlabs | mock
#   suno       -> kendi hesabiniz (Clerk cookie/JWT)
#   replicate  -> resmi API, indirilebilir ses (REPLICATE_API_TOKEN gerekir)
#   elevenlabs -> resmi API, indirilebilir MP3 (ELEVENLABS_API_KEY gerekir)
#   mock       -> API anahtari olmadan uctan uca test
# Istemci uygulamasinda HICBIR degisiklik gerekmez; sozlesme aynidir.
AUDIO_PROVIDER=suno

# --- Replicate ---
REPLICATE_API_TOKEN=
REPLICATE_MODEL=meta/musicgen
REPLICATE_MODEL_VERSION=
REPLICATE_DURATION=30

# --- ElevenLabs Music ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=music_v1
ELEVENLABS_MUSIC_LENGTH_MS=30000
# Bellek ici ses kaydi limiti (Render 512 MB icin guvenli tavan)
ELEVENLABS_MAX_CACHE_MB=32

# --- Mock (test) ---
MOCK_DURATION_SECONDS=6

# ============================================================================
#  SUNO BEAT PROXY - ORTAM DEGISKENLERI ORNEGI
#  Bu dosyayi ".env" olarak kopyalayin:  cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1) ZORUNLU: SUNO OTURUM BILGISI (Clerk "__client" cookie degeri)
# ----------------------------------------------------------------------------
# Nasil alinir?
#   1. Tarayicida https://suno.com adresine giris yapin.
#   2. F12 -> Application (Uygulama) -> Cookies -> https://suno.com
#   3. "__client" isimli cookie'nin Value'sunu kopyalayin.
#   4. Asagiya yapistirin. (Tek satir, bosluksuz, ~1 yil gecerli)
#
# NOT: Tum Cookie header'ini de yapistirabilirsiniz; kod icinde "__client=..."
#      kisimi otomatik olarak ayiklanir.
# ONERILEN (7/24 yenileme icin tek yol):
SUNO_REFRESH_TOKEN=eyJ...buraya__client_cookie_degeri...

# ALTERNATIF: tarayicidan alinmis hazir __session JWT'si.
# __client yoksa servis bununla calisir; ~1 saat sonra tekrar yapistirmak gerekir.
# Tarayicida suno.com/create konsolunda:  await window.Clerk.session.getToken()
# Yapistirdiktan sonra redeploy GEREKMEZ ->  POST /auth/token  { "token": "eyJ..." }
SUNO_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# 2) SUNUCU
# ----------------------------------------------------------------------------
# Render bunu otomatik olarak kendi atar; lokalde 3000 kullanilir.
PORT=3000

# Kendi proxy'nizi korumak icin bir API anahtari belirleyin (onerilir).
# Bos birakirsaniz servis kimlik dogrulama istemez (herkes kullanabilir!).
# Isteklerde:  x-api-key: <deger>   VEYA   Authorization: Bearer <deger>
API_KEY=

# ----------------------------------------------------------------------------
# 3) SUNO / CLERK UC NOKTALARI
#    (Suno altyapisi zaman zaman alan adi degistirir; koddan degil buradan
#     degistirebilmeniz icin disari alindi.)
# ----------------------------------------------------------------------------
# Eski "studio-api.suno.ai" alan adi 2026 itibariyle yanit vermiyor (503).
SUNO_API_BASE=https://studio-api-prod.suno.com

# Uretim (generate) yolu. Web istemcisi "v2-web" kullaniyor; "v2" hala gecerli.
# 401/400 sorunlarinda alternatifleri deneyin:
#   /api/generate/v2/        (klasik / mobil-web uyumlu)
#   /api/generate/v2-web/    (suno.com web istemcisi)
SUNO_GENERATE_PATH=/api/generate/v2-web/

# Sarki/beat durumunu sorgulamak icin feed yolu (wait=true icin kullanilir)
SUNO_FEED_PATH=/api/feed/v3

# Clerk FAPI adresi. Bazi hesaplarda "https://auth.suno.com" gerekebilir.
CLERK_BASE_URL=https://clerk.suno.com

# Clerk JS surum parametresi (?_clerk_js_version=...)
CLERK_JS_VERSION=5.35.0

# ----------------------------------------------------------------------------
# 4) OTURUM TAZELEME (KEEP-ALIVE)
# ----------------------------------------------------------------------------
# Arka plan gorevinin calisma araligi (ms). Varsayilan: 15 dakika.
KEEPALIVE_INTERVAL_MS=900000

# Token suresinin bitimine kac ms kala yenilensin? (Varsayilan: 5 dakika)
REFRESH_BEFORE_EXPIRY_MS=300000

# ----------------------------------------------------------------------------
# 5) URETIM VARSAYILANLARI
# ----------------------------------------------------------------------------
# Suno modeli: chirp-v3-5 / chirp-v4 / chirp-v4-5 / chirp-v5 ...
DEFAULT_MODEL=chirp-v4

# Istemciden "make_instrumental" gelmezse varsayilan olarak enstrumantal mi?
DEFAULT_INSTRUMENTAL=true

# ----------------------------------------------------------------------------
# 6) AG / HATA AYIKLAMA
# ----------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info

# Browser-Token ARTIK OTOMATIK uretiliyor (Suno web bundle'indaki algoritma:
#   {"token": base64({"timestamp": <ms>})} ). Elle override gerekirse:
SUNO_BROWSER_TOKEN=

# suno_device_id cookie'si (tarayicida: document.cookie icinden veya
# Application > Cookies > suno_device_id). Bos ise rastgele UUID uretilir.
SUNO_DEVICE_ID=

# __client cookie'si studio-api isteklerine de eklensin mi? (Genelde true kalabilir)
FORWARD_CLIENT_COOKIE=true

# ----------------------------------------------------------------------------
# 7) INDIRME PROXY'SI (SSRF KORUMASI)
# ----------------------------------------------------------------------------
# /download?url=... yalnizca bu host'lardan akis yapar. ASLA "*" yapmayin:
# sunucunuz ic aga / bulut metadata'sina (169.254.169.254) tunel olur.
DOWNLOAD_ALLOWED_HOSTS=audiopipe.suno.ai,cdn1.suno.ai,cdn2.suno.ai,cdn.suno.ai,studio-api-prod.suno.com,studio-api.prod.suno.com

# *.suno.ai alt alan adlarina da izin ver (Suno yeni CDN ekleyebiliyor)
DOWNLOAD_ALLOW_SUNO_SUBDOMAINS=true

# ----------------------------------------------------------------------------
# 8) FFMPEG / TRANSCODE (stream bridge)
# ----------------------------------------------------------------------------
# FFmpeg ikilisi: 1) FFMPEG_PATH  2) ffmpeg-static paketi (npm)  3) PATH
# ffmpeg-static kuruluysa (~76 MB disk) hicbir sey yapmaniz gerekmez.
FFMPEG_PATH=

# Transcode'u tamamen kapatmak icin false (passthrough'a duser)
ENABLE_TRANSCODE=true

# Cikti bit hizi
TRANSCODE_BITRATE=128k

# ----------------------------------------------------------------------------
# 9) YALNIZCA YEREL GELISTIRME - PRODUCTION'DA true YAPMAYIN
# ----------------------------------------------------------------------------
# http:// ve IP literal'lerine izin verir (SSRF korumasini zayiflatir).
DOWNLOAD_ALLOW_HTTP=false

# ----------------------------------------------------------------------------
# 10) TRANSPARENT PROXY (ses kaynagi fallback)
# ----------------------------------------------------------------------------
# audio_url "/api/forbidden" ise bu sablon kullanilir. {id} klip id'siyle degisir.
# Sunucu baytlari DEGISTIRMEZ; yalnizca 1:1 aktarir (pass-through).
AUDIOPIPE_URL_TEMPLATE=https://audiopipe.suno.ai/?item_id={id}&format=mp3&encoded=true

# ----------------------------------------------------------------------------
# 11) UPSTREAM HEADER / COOKIE GECISI (audiopipe + CDN)
# ----------------------------------------------------------------------------
# Tarayicidan aldiginiz HAM Cookie header'ini buraya yapistirin (tek satir):
#   F12 > Network > bir studio-api/audiopipe istegi > Request Headers > Cookie
# Bos ise yalnizca token'dan uretilen cookie'ler (__session, __client) gonderilir.
SUNO_COOKIE_JAR=

# Upstream isteklerine Cookie header'i eklensin mi?
FORWARD_UPSTREAM_COOKIES=true

# Upstream'e gonderilen tarayici kimligi (override)
UPSTREAM_ORIGIN=https://suno.com
UPSTREAM_REFERER=https://suno.com/
UPSTREAM_USER_AGENT=

# ----------------------------------------------------------------------------
# 12) SESSION HANDSHAKE (akis oncesi oturum + listen_milestone)
# ----------------------------------------------------------------------------
ENABLE_SESSION_HANDSHAKE=true
HANDSHAKE_TIMEOUT_MS=6000
HANDSHAKE_MILESTONES=5s,30s

# ----------------------------------------------------------------------------
# 13) TLS PARMAK IZI (JA3/JA4)
# ----------------------------------------------------------------------------
# true -> upstream istekleri Chrome benzeri cipher/ALPN/ECDH ile yapilir.
# Not: Node TLS uzanti sirasini ve GREASE degerlerini kontrol edemez;
#      JA3 hash'i Chrome ile birebir eslesmez (bkz. README 15).
CHROME_TLS_PROFILE=true
